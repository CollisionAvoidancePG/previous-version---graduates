<?xml version="1.0"?>
<package format="2">
  <name>mass_control</name>
  <version>1.2.0</version>
  <description>ROS package to send data to mavros</description>

  <maintainer email="mass.ship.pg@gmail.com">mass-pg</maintainer>

  <license>TODO</license> <!-- TODO licence -->

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>catkin_virtualenv</build_depend>

  <build_depend>rospy</build_depend>
  <build_export_depend>rospy</build_export_depend>
  <exec_depend>rospy</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>

  <build_depend>mavros_msgs</build_depend>
  <exec_depend>mavros_msgs</exec_depend>

  <depend>mass_common</depend>

  <export>
    <pip_requirements>requirements.o</pip_requirements>
  </export>
</package>
