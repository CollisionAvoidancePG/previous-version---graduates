<?xml version="1.0"?>
<package format="2">
  <name>mass_camera</name>
  <version>1.1.0</version>
  <description>ROS package to operate depth camera sensor</description>

  <maintainer email="mass.ship.pg@gmail.com">mass-pg</maintainer>

  <license>TODO</license> <!-- TODO licence -->

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>catkin_virtualenv</build_depend>

  <build_depend>rospy</build_depend>
  <build_export_depend>rospy</build_export_depend>
  <exec_depend>rospy</exec_depend>

  <build_depend>std_msgs</build_depend>
  <exec_depend>std_msgs</exec_depend>

  <build_depend>sensor_msgs</build_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <depend>mass_common</depend>
  <depend>zed_interfaces</depend>
  <depend>python3-opencv</depend>
  <depend>python3-testresources</depend>

  <!-- open3d is installed in global environment because it is impossible to get it with format "python3-****" -->
  <!-- <depend>open3d</depend> -->

  <export>
    <pip_requirements>requirements.o</pip_requirements>
  </export>
</package>
